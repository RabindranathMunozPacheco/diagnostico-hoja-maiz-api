        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_duracion_segundos_bucket{ruta=\"/api/diagnostico\",origen=\"usuario\",resultado=\"ok\"}[1m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "refId": "A"
