    {
      "id": 9,
      "type": "timeseries",
      "title": "Tráfico por código (solicitudes/s)",
      "description": "Diagnósticos de usuarios por código HTTP; la sonda aparte.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (codigo) (rate(http_solicitudes_total{ruta=\"/api/diagnostico\",origen=\"usuario\"}[1m]))",
          "legendFormat": "{{codigo}}",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_solicitudes_total{ruta=\"/api/diagnostico\",origen=\"sonda\"}[1m]))",
          "legendFormat": "sonda",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Errores 5xx (%)",
      "description": "Solo los 5xx cuentan contra el SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_solicitudes_total{ruta=\"/api/diagnostico\",origen=\"usuario\",codigo=~\"5..\"}[1m])) / sum(rate(http_solicitudes_total{ruta=\"/api/diagnostico\",origen=\"usuario\"}[1m]))",
          "legendFormat": "errores 5xx",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(diagnostico_rechazos_total{origen=\"usuario\"}[1m])) / sum(rate(http_solicitudes_total{ruta=\"/api/diagnostico\",origen=\"usuario\"}[1m]))",
          "legendFormat": "rechazos 4xx (no gastan presupuesto)",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
