    {
      "id": 12,
      "type": "timeseries",
      "title": "Saturación",
      "description": "CPU en núcleos (límite 1), memoria como fracción del límite.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"api\"}[1m])",
          "legendFormat": "CPU usada (núcleos)",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"api\"} / 1073741824",
          "legendFormat": "memoria (fracción de 1 GiB)",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "http_solicitudes_en_curso",
          "legendFormat": "solicitudes en curso",
          "instant": false,
          "range": true,
