# Copia este archivo como .env para cambiar la configuración sin tocar el código.
# docker compose lo lee solo; con uvicorn en local, exporta las variables antes de arrancar.

# Probabilidad de enfermedad desde la que la hoja se reporta como enferma. Vacío = el de la ficha de la versión
# en servicio (Actividad 6: 0.2494). Bajarlo reporta menos enfermas como sanas, a cambio de más falsas alarmas.
UMBRAL_ENFERMA=

# Tamaño máximo de la foto que acepta la API, en MB
TAMANO_MAX_MB=10

# Puerto de la computadora donde queda publicada la API (dentro del contenedor siempre es 8000)
PUERTO=8000
